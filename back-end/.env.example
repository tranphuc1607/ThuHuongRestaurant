# MySQL
MYSQL_ROOT_PASSWORD=your_password_here

# RabbitMQ — user này được tạo lúc container rabbitmq chạy LẦN ĐẦU (khi volume còn rỗng).
# Đổi sau đó sẽ không có tác dụng, phải xóa volume rabbitmq rồi tạo lại.
RABBITMQ_USER=thuhuong_mq
RABBITMQ_PASSWORD=rabbitmq_secure_2024

# Booking Telegram Bot (order-service) — lấy từ BotFather
BOOKING_TELEGRAM_BOT_TOKEN=
BOOKING_TELEGRAM_BOT_USERNAME=
BOOKING_TELEGRAM_ADMIN_IDS=

# Payment — Sepay webhook
SEPAY_WEBHOOK_APIKEY=
SEPAY_WEBHOOK_ALLOWED_IPS=*

# HR Telegram Bot (hr-service) — lấy từ BotFather
HR_TELEGRAM_BOT_TOKEN=
HR_TELEGRAM_BOT_USERNAME=
HR_TELEGRAM_ADMIN_IDS=
HR_CHECKIN_SECRET=random-long-secret-string-here
HR_WIFI_ALLOWED_IP=*
HR_SERVER_PUBLIC_URL=http://your-server-ip:8080

# Gemini (order-service) — quét hóa đơn AI vision (provider chính), lấy tại aistudio.google.com/apikey
GEMINI_API_KEY=
# Đổi model không cần build lại. Đo trên cùng một hóa đơn (xem eval/README.md):
#   gemini-3.5-flash-lite  ~2,4s  ← mặc định, nhanh nhất, đủ chính xác trên các ca đã thử
#   gemini-3.6-flash       ~7,2s  ← đổi sang đây nếu chữ viết tay thật bị đọc sai nhiều
GEMINI_MODEL=gemini-3.5-flash-lite
# Token "suy nghĩ" cho mỗi lần quét. Đây là núm chỉnh tốc độ chính: để mặc định (-1) model đốt
# ~3200 token suy nghĩ cho 110 token trả lời và chậm gấp nhiều lần. 0 bị API từ chối.
GEMINI_THINKING_BUDGET=128

# OpenRouter (order-service) — đường lui nếu Gemini hết quota, lấy tại openrouter.ai/keys
OPENROUTER_API_KEY=
