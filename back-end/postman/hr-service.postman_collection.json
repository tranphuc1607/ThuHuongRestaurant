            "url": {
              "raw": "{{base_url}}/api/v1/hr/employees/{{employee_id}}/deactivate",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "hr", "employees", "{{employee_id}}", "deactivate"]
            }
          }
        },
        {
          "name": "PATCH Kích hoạt lại nhân viên",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/hr/employees/{{employee_id}}/activate",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "hr", "employees", "{{employee_id}}", "activate"]
            }
          }
        },
        {
          "name": "PATCH Link Telegram cho nhân viên",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"telegramId\": 123456789\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/hr/employees/{{employee_id}}/link-telegram",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "hr", "employees", "{{employee_id}}", "link-telegram"]
            }
          }
        }
      ]
    },
