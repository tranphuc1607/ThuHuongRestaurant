  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string",
      "description": "JWT token của ADMIN (lấy từ POST /api/v1/auth/login)"
    },
    {
      "key": "employee_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "shift_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "attendance_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Employees",
      "item": [
        {
          "name": "GET Danh sách nhân viên",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/hr/employees?page=0&size=20",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "hr", "employees"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "search", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "GET Chi tiết nhân viên",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/hr/employees/{{employee_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "hr", "employees", "{{employee_id}}"]
            }
          }
        },
        {
          "name": "POST Tạo nhân viên (PART_TIME - lương giờ)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nguyễn Văn A\",\n  \"phone\": \"0901234567\",\n  \"type\": \"PART_TIME\",\n  \"salaryType\": \"HOURLY\",\n  \"baseValue\": 25000,\n  \"targetDays\": null\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/hr/employees",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "hr", "employees"]
            }
          }
        },
        {
          "name": "POST Tạo nhân viên (FULL_TIME - lương tháng)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Trần Thị B\",\n  \"phone\": \"0987654321\",\n  \"type\": \"FULL_TIME\",\n  \"salaryType\": \"FIXED\",\n  \"baseValue\": 6000000,\n  \"targetDays\": 26\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/hr/employees",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "hr", "employees"]
            }
          }
        },
        {
          "name": "PUT Cập nhật nhân viên",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nguyễn Văn A (sửa)\",\n  \"phone\": \"0901234567\",\n  \"type\": \"PART_TIME\",\n  \"salaryType\": \"HOURLY\",\n  \"baseValue\": 30000,\n  \"targetDays\": null\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/hr/employees/{{employee_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "hr", "employees", "{{employee_id}}"]
            }
          }
        },
        {
          "name": "PATCH Vô hiệu hóa nhân viên",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
